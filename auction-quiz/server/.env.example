# Copy to .env to override defaults. Everything is optional —
# the server runs fine with built-in defaults and no .env file.

# HTTP + Socket.IO port
PORT=3000

# Admin key for starting auctions and importing questions
ADMIN_KEY=scet

# Optional: rename template files on disk when marked used (e.g. file.txt -> used_file.txt)
RENAME_USED_FILES=false
